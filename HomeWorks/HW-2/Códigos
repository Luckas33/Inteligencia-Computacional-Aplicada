      "source": [
        "#FUNÇÃO PARA CALCULO DO MSE\n",
        "def MSE_calculo(y_treino, y_hat):\n",
        "  RSS = ((y_treino - y_hat) ** 2).sum()\n",
        "  MSE = RSS / len(y_treino)\n",
        "  return MSE"
