    {
      "cell_type": "code",
      "source": [
        "def k_fold_cv(X: pd.DataFrame, y: pd.DataFrame, k: int, shuffle: bool=False, seed: int=32, lambd=0):\n",
        "  \"\"\"\n",
        "  Função que implementa a validação cruzada k-fold para regressão linear.\n",
        "  A saída é um vetor de scores de métrica do modelo (R2 na primeira coluna e RMSE na segunda).\n",
        "  \"\"\"\n",
        "\n",
        "  # Ajuste de DataFrame do pandas para ndarray do numpy para\n",
        "  # melhor eficiência no cálculo matricial\n",
        "  X = np.asarray(X, dtype=np.float64)\n",
        "  y = np.asarray(y, dtype=np.float64).ravel()\n",
        "\n",
        "  n = X.shape[0]\n",
        "  idx = np.arange(n)\n",
        "\n",
        "  # No k fold cross validation, as amostras são particionadas aleatoriamente\n",
        "  if shuffle:\n",
        "    np.random.seed(seed)\n",
        "    np.random.shuffle(idx)\n",
        "\n",
        "  # Separa os índices do dataset em k partes\n",
        "  folds = np.array_split(idx, k)\n",
        "\n",
        "  scores = np.zeros((k, 2))\n",
        "\n",
        "  for fold_idx in range(k):\n",
        "    # O conjunto atual para validação\n",
        "    valid_idx = folds[fold_idx]\n",
        "\n",
        "    # O restante é para treino\n",
        "    train_idx = np.concatenate([folds[i] for i in range(k) if i != fold_idx])\n",
        "\n",
        "    X_train, y_train = X[train_idx], y[train_idx]\n",
        "    X_valid, y_valid = X[valid_idx], y[valid_idx]\n",
        "\n",
        "    b_hat = meu_OLS(X_train, y_train, lambd)\n",
        "\n",
        "    y_hat = X_valid @ b_hat\n",
        "    R2 = r2_calculo(y_valid, y_hat)\n",
        "    RMSE = RMSE_calculo(y_valid, y_hat)\n",
        "\n",
        "    scores[fold_idx, 0] = R2\n",
        "    scores[fold_idx, 1] = RMSE\n",
        "\n",
        "  return scores"
      ],
      "metadata": {
        "id": "2GlEl379TwzG"
      },
