        "# Transformação Yeo-Johnson (Alternativa ao Box-Cox que aceita zeros e valores negativos)\n",
        "def tratamento_skewness(df, lambdas=None):\n",
        "    df = df.copy()\n",
        "\n",
        "    if lambdas is None:\n",
        "        lambdas = {}\n",
        "\n",
        "        for col in ['PhysHlth', 'MentHlth']:\n",
        "            if col in df.columns:\n",
        "                df[col], lambdas[col] = stats.yeojohnson(df[col])\n",
        "\n",
        "    else:\n",
        "        for col in ['PhysHlth', 'MentHlth']:\n",
        "            if col in df.columns:\n",
        "                df[col] = stats.yeojohnson(\n",
        "                    df[col],\n",
        "                    lmbda=lambdas[col]\n",
        "                 )\n",
        "    return df, lambdas"
      ],
