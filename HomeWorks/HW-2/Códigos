        "#FUNÇÃO PAARA CALCULAR K-FOLD\n",
        "def kfold_media(X: pd.DataFrame, y: pd.DataFrame, k: int, shuffle: bool=False, seed: int=32, lambd=0):\n",
        "  scores = k_fold_cv(X, y, k, shuffle, seed, lambd)\n",
        "  score_R2_media = scores[:, 0].mean();\n",
        "  score_RMSE_media = scores[:, 1].mean();\n",
        "  return score_R2_media, score_RMSE_media"
