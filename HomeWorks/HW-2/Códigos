        "])\n",
        "fold = 10\n",
        "\n",
        "for j in lambd:\n",
        "  #criando modelo\n",
        "  bp_hat = meu_OLS(Xp_treino, Yp_treino, j)\n",
        "  #previsão\n",
        "  yp_hat = Xp_teste @ bp_hat.values\n",
