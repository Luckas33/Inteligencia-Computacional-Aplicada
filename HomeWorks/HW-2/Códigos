        "#FUNÇÃO PARA CALCULO DO R²\n",
        "def r2_calculo(y_treino, y_hat):\n",
        "  RSS = ((y_treino - y_hat) ** 2).sum()\n",
        "  TSS = ((y_treino - y_treino.mean()) ** 2).sum()\n",
        "  R2 = 1 - (RSS / TSS)\n",
        "  return R2"
      ],
      "metadata": {
