      "cell_type": "code",
      "source": [
        "#função para verificar se é inversivel\n",
        "def eh_inversivel(XTX: np.ndarray) -> bool:\n",
        "  if np.linalg.matrix_rank(XTX) == XTX.shape[1]:\n",
        "    # print(\"é inversível\")\n",
        "    return True\n",
        "  else:\n",
        "    print(\"não é inversível\")\n",
        "    print(np.linalg.matrix_rank(XTX))\n",
        "    return False"
      ],
      "metadata": {
        "id": "Dz_URNL9ZMNG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def meu_OLS(X: np.ndarray, y: np.ndarray, lambd = 0):\n",
        "  XTX = (X.T @ X)\n",
        "  I = np.identity(len(XTX))\n",
        "  I[0, 0] = 0\n",
        "  XTXp = XTX + +(lambd * I)\n",
        "  if eh_inversivel(XTXp):\n",
        "    XTX_inv = np.linalg.inv(XTXp)\n",
        "    b_hat = XTX_inv @ X.T @ y\n",
        "    return b_hat\n",
        "  else:\n",
        "    return None"
      ],
      "metadata": {
        "id": "B1Yav5fNYz6z"
      },
      "execution_count": null,
      "outputs": []
